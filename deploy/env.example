RPC_URL=https://robinhood-rpc.publicnode.com
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
TOKEN_JSON=/opt/rollycall/repo/web/token.json
DOMAIN=rollycall.xyz
SITE_URL=https://rollycall.xyz
MIN_HOLD=0
